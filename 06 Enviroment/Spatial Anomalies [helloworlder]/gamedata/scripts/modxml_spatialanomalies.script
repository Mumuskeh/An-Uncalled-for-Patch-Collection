function on_game_start()
    RegisterScriptCallback("on_specific_character_init", function(character_id, data)

        if character_id == "zat_b18_noah" then
            local res = dialog_list:add("ask_about_compass")

            if res then
                printf("adding dialog %s for %s, pos %s", "ask_about_compass", character_id, res)
            end
        end
    end)
end