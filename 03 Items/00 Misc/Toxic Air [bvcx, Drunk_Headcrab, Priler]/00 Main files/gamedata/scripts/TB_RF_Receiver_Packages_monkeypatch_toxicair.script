local function patch_tbrfpackage_tables()
    if not mc_extrautilities then
        return false
    end

    if mc_extrautilities then
		mc_extrautilities{"af_oxygen_tank_1","st_af_oxygen_tank_1_name"}
		mc_extrautilities{"af_oxygen_tank_2","st_af_oxygen_tank_2_name"}
		mc_extrautilities{"af_oxygen_tank_3","st_af_oxygen_tank_3_name"}
		mc_extrautilities{"af_mask_filter_1_gp5","st_af_mask_filter_1_gp5_name"}
		mc_extrautilities{"af_mask_filter_2_m10","st_af_mask_filter_2_m10_name"}
		-- mc_extrautilities{"af_mask_filter_3_fp5","st_af_mask_filter_3_fp5_name"}
		mc_extrautilities{"af_mask_filter_3_nbc70","st_af_mask_filter_3_nbc70_name"}
    end

    -- if mc_faction_army then
		-- mc_faction_army{"af_oxygen_tank_3_military","st_af_oxygen_tank_3_military_name"}
    -- end
    if mc_faction_bandit then
		mc_faction_bandit{"af_mask_filter_2_mof6","st_af_mask_filter_2_mof6_name"}
    end
    if mc_faction_csky then
		mc_faction_csky{"af_oxygen_tank_1_soviet","st_af_oxygen_tank_1_soviet_name"}
    end
    if mc_faction_dolg then
		mc_faction_dolg{"af_mask_filter_2_m10_dolg","st_af_mask_filter_2_m10_dolg_name"}
    end
    if mc_faction_ecolog then
		mc_faction_ecolog{"af_mask_filter_1_m58_sci","st_af_mask_filter_1_m58_sci_name"}
    end
    -- if mc_faction_freedom then
    -- end
    -- if mc_faction_greh then
    -- end
    if mc_faction_isg then
		mc_faction_isg{"af_mask_filter_3_nbc77_isg","st_af_mask_filter_3_nbc77_isg_name"}
    end
    if mc_faction_killer then
		mc_faction_killer{"af_mask_filter_0_ms4","st_af_mask_filter_0_ms4_name"}
		-- mc_faction_killer{"af_mask_filter_3_r18","st_af_mask_filter_3_r18_name"}
    end
    -- if mc_faction_monolith then
    -- end
    if mc_faction_renegade then
		mc_faction_renegade{"af_oxygen_tank_1_soviet","st_af_oxygen_tank_1_soviet_name"}
    end
    return true
end

if not patch_tbrfpackage_tables() then
    CreateTimeEvent("tbrfpackage_patch", "wait_for_tables", 1.0, function()
        if patch_tbrfpackage_tables() then
            return true
        end
        return false
    end)
end

local original_on_game_start = on_game_start
function on_game_start()
    if original_on_game_start then
        original_on_game_start()
    end
    patch_tbrfpackage_tables()
end