function on_game_start()
    local bandages = axr_otheal.bandages
    local medkits = axr_otheal.medkits
	
    if bandages then
        bandages["hsurv_bandage"] = true
    end
	if medkits then
        medkits["hsurv_medkit_light"] = true
        medkits["hsurv_medkit_medium"] = true
        medkits["hsurv_medkit_heavy"] = true
        medkits["hsurv_stimpack"] = true
    end
end