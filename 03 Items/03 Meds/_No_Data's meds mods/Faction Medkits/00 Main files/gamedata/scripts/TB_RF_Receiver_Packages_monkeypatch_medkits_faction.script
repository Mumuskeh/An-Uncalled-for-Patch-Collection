local function patch_tbrfpackage_tables()
    if not mc_faction_army then
        return false
    end

    if mc_faction_bandit then
		mc_faction_bandit{"medkit_faction_bandit","st_medkit_faction_bandit"}
    end
    if mc_faction_csky then
		mc_faction_csky{"medkit_faction_clearsky","st_medkit_faction_clearsky"}
    end
    if mc_faction_dolg then
		mc_faction_dolg{"medkit_faction_duty","st_medkit_faction_duty"}
    end
    if mc_faction_freedom then
		mc_faction_freedom{"medkit_faction_freedom","st_medkit_faction_freedom"}
    end
    if mc_faction_greh then
		mc_faction_greh{"medkit_faction_sin","st_medkit_faction_sin"}
    end
    if mc_faction_isg then
		mc_faction_isg{"medkit_faction_isg","st_medkit_faction_isg"}
    end
    if mc_faction_killer then
		mc_faction_killer{"medkit_faction_merc","st_medkit_faction_merc"}
    end
    if mc_faction_monolith then
		mc_faction_monolith{"medkit_faction_monolith","st_medkit_faction_monolith"}
    end
    if mc_faction_renegade then
		mc_faction_renegade{"medkit_faction_renegade","st_medkit_faction_renegade"}
    end
    
    return true
end

if not patch_tbrfpackage_tables() then
    CreateTimeEvent("tbrfpackage_patch", "wait_for_tables", 1.0, function()
        if patch_tbrfpackage_tables() then
            return true
        end
        return false
    end)
end

local original_on_game_start = on_game_start
function on_game_start()
    if original_on_game_start then
        original_on_game_start()
    end
    patch_tbrfpackage_tables()
end