local function patch_tbrfpackage_tables()
    if not tb_extraloot and mc_faction_army then
        return false
    end

    if tb_extraloot then
		tb_extraloot{"medkit_civilian","st_medkit_civilian"}
		tb_extraloot{"bandage_cooling","st_bandage_cooling"}
		tb_extraloot{"bandage_presure","st_bandage_presure"}
    end

    if mc_faction_army then
		mc_faction_army{"medkit_tactical","st_medkit_tactical"}
    end
    if mc_faction_csky then
		mc_faction_csky{"medkit_detox","st_medkit_detox"}
    end
    if mc_faction_dolg then
		mc_faction_dolg{"medkit_tactical","st_medkit_tactical"}
    end
    if mc_faction_ecolog then
		mc_faction_ecolog{"medkit_detox","st_medkit_detox"}
    end
    if mc_faction_isg then
		mc_faction_isg{"medkit_combat","st_medkit_combat"}
    end
    if mc_faction_killer then
		mc_faction_killer{"medkit_combat","st_medkit_combat"}
    end
    if mc_faction_monolith then
		mc_faction_monolith{"medkit_combat","st_medkit_combat"}
    end

    return true
end

if not patch_tbrfpackage_tables() then
    CreateTimeEvent("tbrfpackage_patch", "wait_for_tables", 1.0, function()
        if patch_tbrfpackage_tables() then
            return true
        end
        return false
    end)
end

local original_on_game_start = on_game_start
function on_game_start()
    if original_on_game_start then
        original_on_game_start()
    end
    patch_tbrfpackage_tables()
end